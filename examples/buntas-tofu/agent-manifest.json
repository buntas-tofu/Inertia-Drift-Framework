{
  "$schema": "./agent-manifest.schema.json",
  "manifest_version": "0.1.0",

  "_DMF_global": {
    "_comment": "Populated GLOBAL defaults for the buntas-tofu principal. Example of a completed owner block; adopters fill their own.",
    "owner": {
      "name": "buntas-tofu",
      "contact": "buntas-tofu@users.noreply.github.com"
    },
    "defaults": {
      "license": "MIT",
      "versioning_scheme": "semver",
      "timestamp_format": "RFC3339",
      "hash_algorithm": "sha256",
      "changelog": "CHANGELOG.md",
      "inference_posture": "labeled",
      "authority_model": "three-tier"
    }
  },

  "project": {
    "name": "example-project",
    "description": "A project governed under DMF with the buntas-tofu principal GLOBAL.",
    "version": "0.1.0",
    "repo_root": ".",
    "primary_language": "markdown",
    "framework": "dmf",
    "readme": "README.md",
    "agents_doc": "AGENTS.md"
  },

  "agent_contract": {
    "prompt_pack": "",
    "policies": [
      "AGENTS.md"
    ],
    "schemas": [
      "agent-manifest.schema.json"
    ],
    "state_snapshot": ""
  },

  "tools": [
    {
      "tool_id": "inertia-drift-lint",
      "description": "The DMF invariant linter: fences, pointers, manifests, status lines, style floor."
    }
  ],

  "provenance": {
    "run_manifest_dir": "runs/",
    "timestamp_format": "RFC3339",
    "hash": "sha256"
  },

  "versioning": {
    "scheme": "semver",
    "changelog": "CHANGELOG.md"
  }
}
